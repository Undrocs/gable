fn main() {
    print(1 + 2 * 3);
    print((1 + 2) * 3);
    print(10 / 3);
    print(-10 / 3);
    print(10 % 3);
    print(-10 % 3);
    print(0x10 + 0b11);

    var x: i32 = 2147483647;
    x = x + 1;
    print(x);

    var y: i8 = 127;
    y = y + 1;
    print(y);

    var z: u8 = 255;
    z = z + 1;
    print(z);

    let big: i64 = 9223372036854775807;
    print(big + 1);
}
