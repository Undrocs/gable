// Integer arithmetic is defined at the width of its operands. Every result below
// is the mathematical result reduced to the bits the type holds, which is what
// makes overflow a defined wrap rather than C's undefined behaviour.
fn main() {
    let max_u8: u8 = 255;
    print(max_u8 + 1);
    print((max_u8 + 1) == 0);
    let zero_u8: u8 = 0;
    print(zero_u8 - 1);
    let big_u8: u8 = 200;
    print(big_u8 * 2);

    let max_i8: i8 = 127;
    print(max_i8 + 1);
    let min_i8: i8 = -128;
    print(min_i8 - 1);
    print(max_i8 * 3);
    print(min_i8 / 1);
    print(min_i8 % 1);

    let max_u16: u16 = 65535;
    print(max_u16 + 1);
    print(max_u16 * max_u16);
    let max_i16: i16 = 32767;
    print(max_i16 + 1);
    print(min_i16() / -1);

    let max_u32: u32 = 4294967295;
    print(max_u32 + 1);
    let large_u32: u32 = 3000000000;
    print(large_u32 * 3);
    let max_i32: i32 = 2147483647;
    print(max_i32 + 1);

    let max_u64: u64 = 18446744073709551615;
    print(max_u64 + 1);
    print(max_u64 * 2);
    let max_i64: i64 = 9223372036854775807;
    print(max_i64 + 1);

    // Nested expressions of narrow types keep the same rule at every step.
    print((big_u8 + 100) * 1);
    print((big_u8 + 100) == 44);
    print((big_u8 * 2) / 2);

    // Conversions: narrowing keeps the low bits, widening keeps the value.
    let wide: i32 = 300;
    print(wide as u8);
    let negative: i32 = -1;
    print(negative as u8);
    let unsigned_byte: u8 = 255;
    print(unsigned_byte as i8);
    let unsigned_short: u16 = 65535;
    print(unsigned_short as i16);
    print(0 as u8);
}

fn min_i16() -> i16 {
    return -32768;
}
