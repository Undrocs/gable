fn classify(n: i32) -> str {
    if n < 0 {
        return "negative";
    }
    if n == 0 {
        return "zero";
    }
    return "positive";
}

fn main() {
    print(classify(-5));
    print(classify(0));
    print(classify(42));

    var i: i32 = 0;
    var total: i32 = 0;
    while i < 10 {
        total = total + i;
        i = i + 1;
    }
    print(total);

    var outer: i32 = 1;
    {
        let outer: i32 = 2;
        print(outer);
    }
    print(outer);

    let flag: bool = false;
    if flag {
        print("impossible");
    } else if !flag {
        print("expected");
    } else {
        print("never");
    }
}
