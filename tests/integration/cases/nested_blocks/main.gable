fn main() -> i32 {
    let a: i32 = 1;
    {
        let b: i32 = a + 1;
        {
            let c: i32 = b + 1;
            print(c);
        }
        print(b);
    }
    print(a);
    var i: i32 = 0;
    while i < 2 {
        var j: i32 = 0;
        while j < 2 {
            print(i * 10 + j);
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
