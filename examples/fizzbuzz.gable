// Prints the numbers 1..20, replacing multiples of 3, 5, and 15.
fn multiple_of(n: i32, divisor: i32) -> bool {
    return n % divisor == 0;
}

fn main() -> i32 {
    var n: i32 = 1;
    while n <= 20 {
        if multiple_of(n, 15) {
            print("FizzBuzz");
        } else if multiple_of(n, 3) {
            print("Fizz");
        } else if multiple_of(n, 5) {
            print("Buzz");
        } else {
            print(n);
        }
        n = n + 1;
    }
    return 0;
}
