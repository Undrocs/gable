// Prints the numbers 1..20, replacing multiples of 3, 5, and 15.
fn multiple_of(n: int, divisor: int) -> bool {
    return n % divisor == 0
}

fn main() {
    for n in 1..21 {
        var word = ""
        if multiple_of(n, 3) {
            word = word + "Fizz"
        }
        if multiple_of(n, 5) {
            word = word + "Buzz"
        }
        if word == "" {
            print(n)
        } else {
            print(word)
        }
    }
}
