// Command-line arguments: index 0 is the program name, so user arguments start
// at 1. Anything after `--` on the command line arrives here.
fn main() {
    if arg_count() < 2 {
        print("no arguments; run with: gable run examples/args.gable -- Ada Grace")
        return
    }
    print("hello to ${arg_count() - 1} people")
    for index in 1..arg_count() {
        print("  ${arg(index)}")
    }
}
