// Strings are UTF-8 byte sequences with an explicit length.
fn describe(text: str) -> str {
    return "'" + text + "' has " + str_of_i64(text.len) + " bytes";
}

fn main() -> i32 {
    let greeting: str = "hello";
    let name: str = "gable";
    let message: str = greeting + ", " + name;

    print(message);
    print(describe(message));
    print(message == "hello, gable");
    print(str_trim("  padded  "));

    let parsed = parse_i64("-1234");
    if parsed.ok {
        print(parsed.value);
    } else {
        print("not a number");
    }

    let found = str_find(message, "gable");
    if found.ok {
        let slice = str_slice(message, found.index as i32, 5);
        if slice.ok {
            print(slice.text);
        }
    }
    return 0;
}
