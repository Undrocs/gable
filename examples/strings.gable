// Strings are UTF-8 byte sequences with an explicit length.
fn describe(text: str) -> str {
    return "'$text' has ${text.len} bytes"
}

fn main() {
    let greeting = "hello"
    let name = "gable"
    let message = "$greeting, $name"
    print(message)
    print(describe(message))

    // Trim, split, and join are written on the value they work on. Splitting
    // keeps the spaces around each separator, so the pieces are trimmed too.
    let row = "  ada, grace, hopper  "
    let names: [str] = []
    for piece in row.trim().split(",") {
        names.push(piece.trim())
    }
    print("${names.len} names: ${names.join(" and ")}")

    // Searching reports failure in a value rather than by trapping.
    let found = message.find("gable")
    if found.ok {
        print("'gable' starts at ${found.index}")
    } else {
        print("not found")
    }

    let slice = message.slice(0, 5)
    if slice.ok {
        print("first five bytes: ${slice.text}")
    }

    let parsed = parse_i64("-1234")
    if parsed.ok {
        print("parsed ${parsed.value}, doubled ${parsed.value * 2}")
    }

    print("escaped: \$name, cost: $5")
}
