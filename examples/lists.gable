// Growable lists: append, read, replace, iterate, and keep a list of structs.
struct Score {
    name: str
    points: int
}

fn add(scores: [Score], name: str, points: int) {
    scores.push(Score(name, points))
}

fn total(scores: [Score]) -> int {
    var sum = 0
    for score in scores {
        sum = sum + score.points
    }
    return sum
}

fn main() {
    let scores: [Score] = []
    add(scores, "ada", 12)
    add(scores, "grace", 15)
    add(scores, "alan", 9)

    for score in scores {
        print("${score.name}: ${score.points}")
    }
    print("${scores.len} scores, ${total(scores)} points")

    // A list grows as needed; nothing has to be sized up front.
    let squares: [int] = []
    for i in 0..10 {
        squares.push(i * i)
    }
    print("${squares.len} squares, last is ${squares[9]}")

    // Elements can be replaced by index.
    squares[0] = 100
    print("first is now ${squares[0]}")
}
