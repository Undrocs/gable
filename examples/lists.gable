// Growable lists: append, read, write, iterate, and keep a list of structs.

struct Score {
    name: str,
    points: i64,
}

fn add(scores: [Score], name: str, points: i64) -> void {
    scores.push(Score(name, points))
}

fn total(scores: [Score]) -> i64 {
    var sum: i64 = 0;
    for score in scores {
        sum = sum + score.points;
    }
    return sum;
}

fn main() {
    var scores: [Score] = [];
    add(scores, "ada", 12);
    add(scores, "grace", 15);
    add(scores, "alan", 9);

    for score in scores {
        print(score.name);
        print(score.points);
    }
    print(scores.len);
    print(total(scores));

    // A list grows as needed; nothing has to be sized up front.
    var squares: [i64] = [];
    for i in 0..10 {
        squares.push(i * i)
    }
    print(squares.len);
    print(squares[9]);

    // Elements can be replaced by index.
    squares[0] = 100;
    print(squares[0]);
}
