// Trial division by every integer up to sqrt(n): prints the primes below 50.
fn is_prime(n: int) -> bool {
    if n < 2 {
        return false
    }
    var divisor = 2
    while divisor * divisor <= n {
        if n % divisor == 0 {
            return false
        }
        divisor = divisor + 1
    }
    return true
}

fn main() {
    let found: [int] = []
    for candidate in 2..50 {
        if is_prime(candidate) {
            found.push(candidate)
        }
    }
    for prime in found {
        print(prime)
    }
    print("${found.len} primes below 50")
}
