// A four-function calculator: "2 + 3 * (4 - 1)" is parsed by recursive descent
// over a list of tokens, so precedence and parentheses fall out of the grammar.
struct Step {
    value: int
    next: int
}

fn is_break(piece: str) -> bool {
    return piece == " " || piece == "(" || piece == ")"
}

fn tokenize(text: str) -> [str] {
    let tokens: [str] = []
    var current = ""
    // An empty separator splits the text into single bytes, parentheses included.
    for piece in text.split("") {
        if is_break(piece) {
            if current != "" {
                tokens.push(current)
                current = ""
            }
            if piece != " " {
                tokens.push(piece)
            }
        } else {
            current = current + piece
        }
    }
    if current != "" {
        tokens.push(current)
    }
    return tokens
}

fn parse_sum(tokens: [str], start: int) -> Step {
    let first = parse_product(tokens, start)
    var value = first.value
    var position = first.next
    while position < tokens.len {
        let op = tokens[position]
        if op != "+" && op != "-" {
            break
        }
        let right = parse_product(tokens, position + 1)
        if op == "+" {
            value = value + right.value
        } else {
            value = value - right.value
        }
        position = right.next
    }
    return Step(value, position)
}

fn parse_product(tokens: [str], start: int) -> Step {
    let first = parse_atom(tokens, start)
    var value = first.value
    var position = first.next
    while position < tokens.len {
        let op = tokens[position]
        if op != "*" && op != "/" {
            break
        }
        let right = parse_atom(tokens, position + 1)
        if op == "*" {
            value = value * right.value
        } else {
            value = value / right.value
        }
        position = right.next
    }
    return Step(value, position)
}

fn parse_atom(tokens: [str], start: int) -> Step {
    if start >= tokens.len {
        return Step(0, start)
    }
    let token = tokens[start]
    if token == "(" {
        let inner = parse_sum(tokens, start + 1)
        return Step(inner.value, inner.next + 1)
    }
    if token == "-" {
        let operand = parse_atom(tokens, start + 1)
        return Step(0 - operand.value, operand.next)
    }
    let number = parse_i64(token) else {
        return Step(0, start + 1)
    }
    return Step(number.value, start + 1)
}

fn evaluate(text: str) -> int {
    return parse_sum(tokenize(text), 0).value
}

fn main() {
    if arg_count() >= 2 {
        print("${arg(1)} = ${evaluate(arg(1))}")
        return
    }
    for expression in ["1 + 2 * 3", "(1 + 2) * 3", "10 / 4", "2 * (3 + 4) - 5", "-6 + 10"] {
        print("$expression = ${evaluate(expression)}")
    }
}
