// Greatest common divisor by the Euclidean algorithm, and least common
// multiple derived from it.
fn gcd(a: int, b: int) -> int {
    var x = a
    var y = b
    while y != 0 {
        let remainder = x % y
        x = y
        y = remainder
    }
    return x
}

fn lcm(a: int, b: int) -> int {
    return (a / gcd(a, b)) * b
}

fn main() {
    print("gcd(1071, 462) = ${gcd(1071, 462)}")
    print("lcm(21, 6) = ${lcm(21, 6)}")
    print("gcd(270, 192) = ${gcd(270, 192)}")
}
