// Structs are values: they are copied when assigned, passed, and returned.
struct Point {
    x: int
    y: int
}

struct Rectangle {
    origin: Point
    width: int
    height: int
}

fn area(rectangle: Rectangle) -> int {
    return rectangle.width * rectangle.height
}

fn moved(point: Point, dx: int, dy: int) -> Point {
    // The parameter is immutable, so a modified copy is returned instead.
    var result = point
    result.x = result.x + dx
    result.y = result.y + dy
    return result
}

fn main() {
    let rectangle = Rectangle(Point(1, 2), 3, 4)
    print("area ${area(rectangle)} at (${rectangle.origin.x}, ${rectangle.origin.y})")

    let corner = moved(rectangle.origin, 10, 20)
    print("moved to (${corner.x}, ${corner.y})")
    print("the original is unchanged: (${rectangle.origin.x}, ${rectangle.origin.y})")
}
