// Structs are values: they are copied when assigned, passed, and returned.
struct Point {
    x: i32,
    y: i32,
}

struct Rectangle {
    origin: Point,
    width: i32,
    height: i32,
}

fn area(rectangle: Rectangle) -> i32 {
    return rectangle.width * rectangle.height;
}

fn moved(point: Point, dx: i32, dy: i32) -> Point {
    // The parameter is immutable, so a modified copy is returned instead.
    var result: Point = point;
    result.x = result.x + dx;
    result.y = result.y + dy;
    return result;
}

fn main() {
    let rectangle: Rectangle = Rectangle(Point(1, 2), 3, 4);
    print(rectangle.origin.x);
    print(area(rectangle));

    let corner: Point = moved(rectangle.origin, 10, 20);
    print(corner.x);
    print(corner.y);

    var counter: Point = Point(0, 0);
    counter.x = counter.x + 1;
    print(counter.x);
}
