// Prints the first 15 Fibonacci numbers. Integers wrap, so the values stay
// defined even though they grow quickly.
fn fib(n: int) -> int {
    var a = 0
    var b = 1
    var i = 0
    while i < n {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    return a
}

fn main() {
    for i in 0..15 {
        print("fib($i) = ${fib(i)}")
    }
}
