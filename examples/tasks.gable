// A small task list: a struct, a fixed array, and a loop.
struct Task {
    title: str
    done: bool
}

fn count_done(tasks: [Task; 3]) -> int {
    var done = 0
    for task in tasks {
        if task.done {
            done = done + 1
        }
    }
    return done
}

fn main() {
    let tasks: [Task; 3] = [
        Task("write the specification", true),
        Task("add arrays", true),
        Task("write the notes tool", false),
    ]

    var index = 0
    for task in tasks {
        index = index + 1
        var mark = "[ ]"
        if task.done {
            mark = "[x]"
        }
        print("$index. $mark ${task.title}")
    }

    print("${count_done(tasks)} of ${tasks.len} done")
}
