root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,c}]
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[*.gable]
indent_size = 4
max_line_length = 100

[*.yml]
indent_size = 2

[CMakeLists.txt]
indent_size = 2
